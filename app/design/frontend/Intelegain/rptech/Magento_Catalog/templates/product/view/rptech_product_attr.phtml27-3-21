	<script type="text/javascript">
		require(['jquery'], function($) {
			$(document).ready(function() {
				$("#checkpincode").click(function() {
					$("#spanpinloader").show();
					<?php
					header('Access-Control-Allow-Origin: *');
					header('Authorization: Token f939438eba9c2d712539be8fc9991c056a142696');
					?>
					var pincode = $("#pincode_check").val();
					var flag = true;
					if (isNaN(pincode)) {
						flag = false;
					}
					if (pincode) {
						//alert(pincode + "==>not empty")
						//call remote api to check pincode
						if (flag) {
							var api_url = 'https://staging-express.delhivery.com/c/api/pin-codes/json/'
							var key = '5b578yg9yvi8sogirbvegoiufg9v9g579gviuiub8' // not real
							$.ajax({
								url: 'callRemoteApi.php', //api_url + "?filter_codes=" + pincode,
								type: 'GET',
								dataType: 'json',
								data: {
									pincode: pincode
								},
								contentType: 'application/json',
								success: function(result) {
									$("#spanpinloader").hide();
									var msg;
									if (result > 0) {
										msg = "This product can be delivered on given pincode";
									} else {

										msg = "This product not delivered on given pincode";
									}
									$("#showpincodemsg").text(msg);
								},
								error: function(error) {
									console.log(error);
								}
							});

						} else {
							$("#spanpinloader").hide();
							alert('Please enter numebers only');

						}

					} else {
						$("#spanpinloader").hide();
						alert('Please enter pincode');
					}
				});
			});
		});
	</script>
