$objectManager = \Magento\Framework\App\ObjectManager::getInstance();
/** @var  $coll \Magento\Eav\Model\ResourceModel\Entity\Attribute\Collection */
$groupCollection = $objectManager->create('Magento\Eav\Model\ResourceModel\Entity\Attribute\Group\Collection');
$groupCollection->addFieldToFilter('attribute_set_id', $attributeSetId);
$groupCollection->addFieldToFilter('tab_group_code', array('null' => true));
$groupCollection->addFieldToFilter('attribute_group_code', array('neq' => 'magemob-inventory'));
$groupCollection->addFieldToFilter('attribute_group_code', array('neq' => 'gift-options'));
$groupCollection->addFieldToFilter('attribute_group_code', array('neq' => 'bundle-items'));
