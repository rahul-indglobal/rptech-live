                    } else {
                        //console.log("with swatch options");
                        if($("#product-options-wrapper .fieldset .swatch-opt .swatch-attribute").length) {
                            //console.log("Exists now");
                            flg_option = 1;
                        } else {
                            //console.log("Does not exist");
                        }
                    }
                    setTimeout(function() {
                        flg_fb = 1;
