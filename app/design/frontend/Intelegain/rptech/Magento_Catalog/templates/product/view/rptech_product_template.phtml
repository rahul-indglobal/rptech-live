                        console.log("Found");
                        flg_fb = 1;
                    } else {
                        console.log("Not Found");
                    }*/

                if(flg_fb==1 && flg_option==1) {
                    $('.catalog-product-view .main-content').addClass('content-loaded');
                    clearInterval(load_interval);
                }
            }, 1000);

            var link_signin = $("#review-form a:contains('Sign in')");
            $(link_signin).click(function(e){
                e.preventDefault();
                doLogin();
            });
        });

        function select_product()
        {
            var selected_options = {};
            jQuery('div.swatch-attribute').each(function(k,v){
                var attribute_id    = jQuery(v).attr('attribute-id');
                var option_selected = jQuery(v).attr('option-selected');
                // console.log(attribute_id, option_selected);
                if(!attribute_id || !option_selected){ return; }
                selected_options[attribute_id] = option_selected;
            });

            //var product_id_index = jQuery('[data-role=swatch-options]').data('mageSwatchRenderer').options.jsonConfig.index;
            var found_ids = [];
            //console.log(product_id_index);
            // jQuery.each(product_id_index, function(product_id,attributes){
            //     //console.log(product_id);
            //     var productIsSelected = function(attributes, selected_options){
            //         return _.isEqual(attributes, selected_options);
            //     }
            //     if(productIsSelected(attributes, selected_options)){
            //         found_ids.push(product_id);
            //     }
            // });
            if (found_ids.length) {
                //console.log(found_ids);
                if(found_ids[0]!=simpleId_old)
                {
                    update_product_values(found_ids[0]);
                }
            }
        }

        function update_product_values(simpleId)
        {
            var cur_prd = $("input[name='product']").val();
            /*console.log("old = "+simpleId_old+" and new = "+simpleId);*/
            if(simpleId && simpleId!=simpleId_old) {
                /*console.log("processing for "+simpleId);*/
                //if(val) {
                //var simpleId=jQuery("input[name=selected_configurable_option]").val();
                /* PRODUCT NAME/TITLE */
                $("h1.product-title").hide();
                $("h1.product-title.config_child_"+simpleId).show();

                /* PRODUCT LABEL */
                $("div.col-right > div.product-tag").hide();
                $("div.col-right > div.product-tag.config_label_child_"+simpleId).show();

                /* GALLERY IMAGES */
                $(".main-slider.mainslide").hide();
                $(".main-slider.mainslide.images"+simpleId).show();
                $(".slider-nav").hide();
                $(".slider-nav.gallery"+simpleId).show();
                var img_src = $(".main-slider.mainslide.images"+simpleId+" img").attr("src");
                $("div.zoomContainer").hide();
                var zoom_cont = $("div.zoomContainer").find("div[style*='"+img_src+"']");
                $(zoom_cont).parents("div.zoomContainer").show();
                //$(".main-slider-wrap").hide();
                //$(".main-slider-"+simpleId).show();
                //$(".main-slider-"+simpleId).css("visibility", "visible");
                //$(".main-slider-"+simpleId+".slick-initialized").css("visibility", "visible");
                //$(".slider-nav-wrap").hide();
                //$(".slider-nav-"+simpleId).show();
                //$(".slider-nav-"+simpleId).css("visibility", "visible");
                //$(".slider-nav-"+simpleId+".slick-initialized").css("visibility", "visible");
                //$("div.zoomContainer").css({"height":423});
                //$("div.zoomWrapper").css({"height":423});
                update_zoom();
                $(".slick-initialized").slick("refresh");

                /* PRICE */
                $("div.price > span.rs .configPrice").hide();
                $("div.price > span.rs .configPrice.price"+simpleId).show();

                /* STOCK STATUS */
                $("div.price > span.rs2").hide();
                $("div.price > span.rs2.config_rs2_child_"+simpleId).show();

                /* POPUP PRICE-1 */
                $("div.details > ul > li:first-child > .pull-right").hide();
                $("div.details > ul > li:first-child > .pull-right.config_mrp_child_"+simpleId).show();

                /* POPUP QUANTITY */
                $("div[class*='config_qty_child']").hide();
                $(".config_qty_child_"+simpleId).show();

                /* POPUP PRICE-2 */
                $("div.details > ul > li.lastTotal").hide();
                $("div.details > ul > li.lastTotal.config_total_child_"+simpleId).show();

                /* ADD TO CART/SEND ENQUIRY */
                $("button.btn.action.primary.tocart").hide();
                $("a.btn.btn-enq").hide();
                if($("button#product-addtocart-button-"+simpleId).length>0) {
                    $("button#product-addtocart-button-"+simpleId).show();
                    $("div.buynow-button").show();
                    $("div.field.qty").show();
                } else if($("a#product"+simpleId).length>0) {
                    $("a#product"+simpleId).show();
                    $("div.buynow-button").hide();
                    $("div.field.qty").hide();
                }

                /* DESCRIPTION */
                $("div.para").hide();
                $("div.config_para_child_"+simpleId).show();

                /* SPECIFICATION */
                $("div#Specification > table.configurable").hide();
                $("div#Specification > table#config_specs_child_"+simpleId).show();
                simpleId_old = simpleId;
            } else {
                /* PRODUCT NAME/TITLE */
                $("h1.product-title").hide();
                $("h1.product-title").first().show();

                /* PRODUCT LABEL */
                $("div.col-right > div.product-tag").hide();
                $("div.col-right > div.product-tag").first().show();

                /* GALLERY IMAGES */
                $(".main-slider.mainslide").hide();
                $(".main-slider.mainslide").first().show();
                $(".slider-nav").hide();
                $(".slider-nav").first().show();
                var img_src = $(".main-slider.mainslide img").first().attr("src");
                $("div.zoomContainer").hide();
                var zoom_cont = $("div.zoomContainer").find("div[style*='"+img_src+"']");
                $(zoom_cont).parents("div.zoomContainer").show();
                $(".slick-initialized").slick("refresh");

                /* STOCK STATUS */
                $("div.price > span.rs2").hide();
                $("div.price > span.rs2").first().show();

                /* POPUP PRICE-1 */
                $("div.details > ul > li > .pull-right").hide();
                $("div.details > ul > li > .pull-right").first().show();

                /* POPUP QUANTITY */
                $("div[class*='config_qty_child']").hide();

                /* POPUP PRICE-2 */
                $("div.details > ul > li.lastTotal").hide();
                $("div.details > ul > li.lastTotal").first().show();

                /* ADD TO CART/SEND ENQUIRY */
                $("button.btn.action.primary.tocart").hide();
                $("div.actions.product-btn > a.btn.btn-enq").hide();
                if($("button#product-addtocart-button").length>0) {
                    $("button#product-addtocart-button").show();
                }
                else if($("a#product"+cur_prd).length>0) {
                    $("a#product"+cur_prd).show();
                }
                if($("div.buynow-button").length>0) {
                    $("div.buynow-button").show();
                }
                $("div.field.qty").show();

                /* DESCRIPTION */
                $("div.para").hide();
                $("div.para").first().show();

                /* SPECIFICATION */
                $("div#Specification > table.configurable").hide();
                $("div#Specification > table.configurable").first().show();
            }
        }

        function update_zoom()
        {
            var img_src = $(".main-slider.mainslide img").first().attr("src");
            var zoom_cont = $("div.zoomContainer").find("div[style*='"+img_src+"']");
            var zoom_cont_width = $(zoom_cont).parents("div.zoomContainer").width();
            var zoom_cont_height = $(zoom_cont).parents("div.zoomContainer").height();
            /*console.log(zoom_cont_height + " x " +zoom_cont_width);*/
            $("div.zoomContainer").width(zoom_cont_width).height(zoom_cont_height);
            $("div.zoomWrapper").width(zoom_cont_width).height(zoom_cont_height);
            setTimeout(function (){
                $(".slider-nav .slick-track a.elevatezoom-gallery.item.slick-slide").width(slick_track_item_width);
                $(".slider-nav .slick-track").width(slick_track_item_width_outer*4);
            }, 100);
        }

        var simpleId_old = "";
        $(".product-options-wrapper select[id^='attribute']").on('change', function() {
            var val = $(this).val();
            setTimeout(function (){
                var simpleId = $("input[name=selected_configurable_option]").val();
                /*console.log("old = "+simpleId_old+" and new = "+simpleId);*/
                if(val && simpleId && simpleId!=simpleId_old)
                {
                    update_product_values(simpleId);
                }
            }, 300);
        });
    });
</script>
