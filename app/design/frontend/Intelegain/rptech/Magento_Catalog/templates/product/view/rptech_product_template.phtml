<script type="text/javascript">
    require(['jquery'],function($){
        var slick_track_item_width = slick_track_item_width_outer = "";
        $(document).ready(function(){
            console.log('Clicked 309');
            $(document).on("click","div.swatch-attribute > div.swatch-attribute-options > div.swatch-option", function(){
                console.log('Clicked 311');
                select_product();
            });
            $(document).on("change","div.swatch-attribute > div.swatch-attribute-options > select.swatch-select", function(){
                select_product();
            });
            setTimeout(function (){
                slick_track_item_width = $("#gallery_01 .slick-track .elevatezoom-gallery.item.slick-slide").first().width();
                slick_track_item_width_outer = $("#gallery_01 .slick-track .elevatezoom-gallery.item.slick-slide").first().outerWidth();
