                                    </button>

                                <?php } else { ?>
                                    <?php
                                    $sell_status = $_product->getResource()->getAttribute('sell_status')->getFrontend()->getValue($_product);
                                    if ($sell_status == 'Yes' && $_product->getFinalPrice() > 0 && $_product->getIsSalable()) {
                                        ?>
                                        <button type="submit"
                                                title="<?= $block->escapeHtml(__('Add to Cart')) ?>"
                                                class="action tocart primary btn btn-cart">
