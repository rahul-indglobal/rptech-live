//                        echo substr($_productNameStripped, 0, 60).'...';
//                    }else{
//                        echo $_productNameStripped;
//                    }
                        echo $_productNameStripped;
                    ?>
                                </a>
                            </h3>
                            <?php
                                $firstOption = "";
                                $lastOption = "";
                                $attributeCode = 'pendrive_capacity';
                                if ($_product->getTypeId() == 'configurable') {
                                    $product = $_product;
                                    $childProducts = $product->getTypeInstance()->getUsedProducts($product);
                                    $labels = [];
                                    $attribute = $product->getResource()->getAttribute($attributeCode);
                                    $sourceModel = $attribute->getSource();
                                    foreach ($childProducts as $childProduct) {
                                        // Get the attribute value
                                        $attributeValue = $childProduct->getData($attributeCode);
        
                                        if ($attributeValue) {
                                            // If there are multiple values, split them and add to the array
                                            $valueArray = explode(',', $attributeValue);
            
                                            foreach ($valueArray as $value) {
                                                $value = trim($value);
                                                $optionText = $sourceModel->getOptionText($value);
                                                if ($optionText) {
                                                    $labels[] = $optionText;
                                                }
                                            }
                                        }
                                    }
                                    
                                    // Remove duplicates and sort values
                                    $labels = array_unique($labels);
                                    if(!empty($labels)){
                                        $lastOption = end($labels);
                                        $firstOption = $labels[0];
                                    }
                                    ?>
                                    <div class="pendrive-capacity-swatch">
                                        <span><?php echo __('Capacity:'); ?></span>
                                        <div class="swatch-option first-option">
                                            <?php echo $firstOption; ?>
                                        </div>
                                        <span><?php echo __(' - ')?></span>
                                        <div class="swatch-option last-option">
                                            <?php echo $lastOption; ?>
                                        </div>
                                    </div>
                            <?php } ?>
                            
                            <p class="product-desc">
                                <?php 
                                $_productDescStripped = $_product->getShortDescription();
                                if(strlen($_productDescStripped ?? '') > 50){
                                    echo substr($_productDescStripped, 0, 50).'...';
                                }else{
                                    echo $_productDescStripped;
                                }
                                ?>
