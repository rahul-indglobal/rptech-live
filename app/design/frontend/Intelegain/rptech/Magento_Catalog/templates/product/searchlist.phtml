                                </div>    
                            <?php } else { ?>  
                                <?php if($_product->getFinalPrice() > 0):?>
                                    <div class="price-tag" style="font-weight: 800; display: none;">
                                        <span class="price" style="float: none;"><?php echo $priceHelper->currency($_product->getFinalPrice(), true, false); ?></span>
                                    
                                        <p style="width: 55%;float: right;position: relative;color: #2b2b2b;font-weight: 400;">
                                            <?php
                                                if ($_product->getSpecialPrice() && $_product->getSpecialFromDate() != null && $_product->getSpecialTodate() != null && (strtotime($_product->getSpecialFromDate()) <= strtotime(date('Y-m-d')) && strtotime($_product->getSpecialTodate()) >= strtotime(date('Y-m-d')) )) {
                                                $calculateDiscountPerce = (($_product->getPrice() - $_product->getSpecialPrice()) / $_product->getPrice() ) * 100;
                                            ?>
                                            <span style="text-decoration: line-through;float: left;" ><?= ($_product->getSpecialPrice()) ? $priceHelper->currency($_product->getPrice(), true, false) : ""; ?></span>
                                            <span class="offers" style="float: right;">
                                                <?php //echo ($calculateDiscountPerce) ? round($calculateDiscountPerce) : ""; ?>
                                                % Off</span>
                                            <?php }?>
                                        </p>
                                    </div>
                                <?php endif;?>
                            <?php } ?>       
                        </div>
                        <div class="clearfix btn-wrapper">
