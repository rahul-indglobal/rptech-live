<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Manageewastecontent\Ewastecontent\Api\Data\GridInterface" type="Manageewastecontent\Ewastecontent\Model\Grid" />

    <virtualType name="Manageewastecontent\Ewastecontent\Model\ResourceModel\Grid\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">rptech_ManageEwasteContent</argument>
            <argument name="resourceModel" xsi:type="string">Manageewastecontent\Ewastecontent\Model\ResourceModel\Grid</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="ewaste_record_grid_list_data_source" xsi:type="string">Manageewastecontent\Ewastecontent\Model\ResourceModel\Grid\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
    <type name="Manageewastecontent\Ewastecontent\Logger\Handler">
        <arguments>
            <argument name="filesystem" xsi:type="object">Magento\Framework\Filesystem\Driver\File</argument>
        </arguments>
    </type>
    <type name="Manageewastecontent\Ewastecontent\Logger\Logger">
        <arguments>
            <argument name="name" xsi:type="string">customLogHandler</argument>
            <argument name="handlers"  xsi:type="array">
                <item name="system" xsi:type="object">Manageewastecontent\Ewastecontent\Logger\Handler</item>
            </argument>
        </arguments>
    </type>
</config>
