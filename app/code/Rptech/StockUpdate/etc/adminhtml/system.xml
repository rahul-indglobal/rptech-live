<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="rpt_general">
            <resource>Rptech_General::config</resource>
            <group id="stock" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Stock Update Admins</label>
                <field id="emp_num_1" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>First</label>
                    <comment>Enter mobile number of first employee</comment>
                    <validate>minimum-length-10 maximum-length-12 validate-digits validate-number</validate>
                </field>
                <field id="emp_num_2" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Second</label>
                    <comment>Enter mobile number of second employee</comment>
                    <validate>minimum-length-10 maximum-length-12 validate-digits validate-number</validate>
                </field>
                <field id="emp_num_3" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Second</label>
                    <comment>Enter mobile number of third employee</comment>
                    <validate>minimum-length-10 maximum-length-12 validate-digits validate-number</validate>
                </field>
            </group>
        </section>
    </system>
</config>
