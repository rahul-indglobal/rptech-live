<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">leadership_form.leadership_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">General Information</item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
<!--    <settings>-->
<!--        <buttons>-->
<!--            <button name="save" class="Rptech\Leadership\Block\Adminhtml\Leadership\Edit\SaveButton"/>-->
<!--            <button name="delete" class="Rptech\Leadership\Block\Adminhtml\Leadership\Edit\DeleteButton"/>-->
<!--            <button name="back" class="Rptech\Leadership\Block\Adminhtml\Leadership\Edit\BackButton"/>-->
<!--        </buttons>-->
<!--        <namespace>leadership_form</namespace>-->
<!--        <dataScope>data</dataScope>-->
<!--        <deps>-->
<!--            <dep>leadership_form.leadership_form_data_source</dep>-->
<!--        </deps>-->
<!--    </settings>-->
    <dataSource name="leadership_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="leadership/index/save"/>
        </settings>
        <dataProvider class="Rptech\Leadership\Model\Leadership\DataProvider" name="leadership_form_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>entity_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <fieldset name="general">
        <settings>
            <collapsible>false</collapsible>
            <label/>
        </settings>
        <field name="entity_id" formElement="hidden">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">leadership</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="title" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">leadership</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <label translate="true">Title</label>
                <dataType>text</dataType>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="description" template="ui/form/field" formElement="wysiwyg">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="wysiwygConfigData" xsi:type="array">
                        <item name="height" xsi:type="string">100px</item>
                        <item name="add_variables" xsi:type="boolean">false</item>
                        <item name="add_widgets" xsi:type="boolean">false</item>
                        <item name="add_images" xsi:type="boolean">true</item>
                        <item name="add_directives" xsi:type="boolean">true</item>
                        <item name="is_pagebuilder_enabled" xsi:type="boolean">true</item>
                    </item>
                    <item name="source" xsi:type="string">leadership</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">false</rule>
                </validation>
                <label translate="true">Description</label>
                <dataScope>description</dataScope>
            </settings>
            <formElements>
                <wysiwyg class="Magento\Ui\Component\Form\Element\Wysiwyg">
                    <settings>
                        <rows>8</rows>
                        <wysiwyg>true</wysiwyg>
                    </settings>
                </wysiwyg>
            </formElements>
        </field>
        <field name="image" sortOrder="40" template="Rptech_Leadership/form/element/uploader/image" formElement="imageUploader">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">leadership</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <dataType>string</dataType>
                <label translate="true">Leader Image</label>
                <visible>true</visible>
            </settings>
            <formElements>
                <imageUploader>
                    <settings>
                        <uploaderConfig>
                            <param xsi:type="url" name="url" path="leadership/index_image/upload"/>
                        </uploaderConfig>
                        <previewTmpl>Rptech_Leader/image-preview</previewTmpl>
                        <allowedExtensions>jpg jpeg gif png</allowedExtensions>
                        <maxFileSize>4194304</maxFileSize>
                    </settings>
                </imageUploader>
            </formElements>
        </field>
    </fieldset>
</form>