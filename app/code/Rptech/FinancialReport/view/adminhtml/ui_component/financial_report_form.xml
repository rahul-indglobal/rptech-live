<?xml version="1.0" encoding="UTF-8"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">financial_report_form.financial_report_form_data_source</item>
            <item name="deps" xsi:type="string">financial_report_form.financial_report_form_data_source</item>
        </item>
        <item name="label" xsi:type="string" translate="true">Awards</item>
        <item name="config" xsi:type="array">
            <item name="dataScope" xsi:type="string">data</item>
            <item name="namespace" xsi:type="string">financial_report_form</item>
        </item>
        <item name="template" xsi:type="string">templates/form/collapsible</item>
    </argument>
    <settings>
        <buttons>
            <button name="back"     class="Rptech\FinancialReport\Block\Adminhtml\Data\Edit\Buttons\Back" />
            <button name="delete"   class="Rptech\FinancialReport\Block\Adminhtml\Data\Edit\Buttons\Delete" />
            <button name="reset"    class="Rptech\FinancialReport\Block\Adminhtml\Data\Edit\Buttons\Reset" />
            <button name="save"     class="Rptech\FinancialReport\Block\Adminhtml\Data\Edit\Buttons\Save" />
            <button name="save_and_continue" class="Rptech\FinancialReport\Block\Adminhtml\Data\Edit\Buttons\SaveAndContinue" />
        </buttons>
        <namespace>financial_report_form</namespace>
        <dataScope>data</dataScope>
        <deps>
            <dep>financial_report_form.financial_report_form_data_source</dep>
        </deps>
    </settings>
    <dataSource name="financial_report_form_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Rptech\FinancialReport\Model\FinancialReport\DataProvider</argument>
            <argument name="name" xsi:type="string">financial_report_form_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">entity_id</argument>
            <argument name="requestFieldName" xsi:type="string">entity_id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/form/provider</item>
            </item>
        </argument>
        <settings>
            <submitUrl path="financial/admin/save"/>
        </settings>
    </dataSource>
    <fieldset name="general">
        <settings>
            <collapsible>false</collapsible>
            <label/>
        </settings>
        <field name="entity_id" formElement="hidden">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">financial_report</item>
                </item>
            </argument>
            <settings>
                <dataType>text</dataType>
                <dataScope>entity_id</dataScope>
            </settings>
        </field>
        <field name="title" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">financial_report</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <label translate="true">Title</label>
                <dataType>text</dataType>
                <dataScope>title</dataScope>
            </settings>
        </field>
        <field name="sub_title" formElement="input">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="source" xsi:type="string">financial_report</item>
                </item>
            </argument>
            <settings>
                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
                <label translate="true">Sub Title</label>
                <dataType>text</dataType>
                <dataScope>sub_title</dataScope>
            </settings>
        </field>
        <field name="document">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="dataType" xsi:type="string">string</item>
                    <item name="source" xsi:type="string">Label </item>
                    <item name="label" xsi:type="string" translate="true">Upload</item>
                    <item name="visible" xsi:type="boolean">true</item>
                    <item name="formElement" xsi:type="string">fileUploader</item>
                    <item name="elementTmpl" xsi:type="string">ui/form/element/uploader/uploader</item>
                    <item name="previewTmpl" xsi:type="string">Rptech_FinancialReport/image-preview</item>
                    <item name="isMultipleFiles" xsi:type="boolean">true</item>
                    <item name="required" xsi:type="boolean">true</item>
                    <item name="sortOrder" xsi:type="number">9</item>
                    <item name="uploaderConfig" xsi:type="array">
                        <item name="url" xsi:type="url" path="financial/admin/upload"/>
                    </item>
                </item>
            </argument>
        </field>
        <container name="image_tab_container">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="sortOrder" xsi:type="string">10</item>
                </item>
            </argument>
            <htmlContent name="html_content">
                <argument name="block" xsi:type="object">Rptech\FinancialReport\Block\Adminhtml\ImageBlock</argument>
            </htmlContent>
        </container>
    </fieldset>
</form>