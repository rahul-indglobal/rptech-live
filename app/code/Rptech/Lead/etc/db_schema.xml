<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">

    <table name="rptech_dell_leads" resource="default" engine="innodb" comment="Rptech Leads">

        <!-- Primary Key -->
        <column xsi:type="int" name="lead_id" unsigned="true" nullable="false" identity="true" comment="Lead ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="lead_id"/>
        </constraint>

        <!-- Basic Info -->
        <column xsi:type="varchar" name="type"       nullable="true"  length="255"  comment="Type"/>
        <column xsi:type="varchar" name="first_name" nullable="false" length="100" comment="First Name"/>
        <column xsi:type="varchar" name="last_name"  nullable="false" length="100" comment="Last Name"/>
        <column xsi:type="varchar" name="email"      nullable="false" length="150" comment="Email"/>
        <column xsi:type="varchar" name="phone"      nullable="true"  length="20"  comment="Phone Number"/>
        <column xsi:type="varchar" name="company"    nullable="true"  length="255"  comment="Company"/>

        <!-- System Timestamps -->
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"  comment="Updated At"/>

    </table>

    <table name="rptech_dell_leads_gb10" resource="default" engine="innodb" comment="Rptech Dell Leads">

        <!-- Primary Key -->
        <column xsi:type="int" name="entity_id" unsigned="true" nullable="false" identity="true" comment="Lead Entity ID"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="entity_id"/>
        </constraint>

        <!-- Basic Info -->
        <column xsi:type="varchar" name="type"       nullable="true"  length="255"  comment="Type"/>
        <column xsi:type="varchar" name="full_name" nullable="false" length="100" comment="Full Name"/>
        <column xsi:type="varchar" name="company"  nullable="false" length="255" comment="Company Name"/>
        <column xsi:type="varchar" name="email"      nullable="false" length="150" comment="Email"/>
        <column xsi:type="varchar" name="role"  nullable="false" length="255" comment="Role"/>
        <column xsi:type="varchar" name="industry"  nullable="false" length="255" comment="Industry"/>

        <!-- System Timestamps -->
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="false" comment="Created At"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"  comment="Updated At"/>

    </table>
</schema>
