<script type="text/javascript">
    require(['jquery', 'mage/validation'], function($){
        $(document).ready(function() {
            $('input[name="email"]').on('keyup change', function (){
                if ($('#ittbp').is(':visible') || $('#otp-box').is(':visible')) {
                    $('#send-otp-btn').show();
                    $('#ittbp').hide();
                    $('#ittbp').prop('disabled', true);
                    $('.otp-digit').val("");
                    $('.otp-status').val("");
                    $('.otp-box').hide();
                }
            });



            // Add validation rules manually
            $('#dell_form').validate({
                rules: {
                    first_name: {
                        required: true,
                        pattern: /^[A-Za-z ]+$/,
                        minlength: 2
                    },
                    last_name: {
                        required: true,
                        pattern: /^[A-Za-z ]+$/,
                        minlength: 2
                    },
                    phone: {
                        required: true,
                        digits: true,
                        minlength: 10,
                        maxlength: 15
                    },
                    email: {
                        required: true,
                        email: true
                    },
                    companyname: {
                        required: true,
                        pattern: /^[A-Za-z0-9 .,&-]+$/,
                        minlength: 2
                    }
                },
                messages: {
                    firstname: {
                        required: "Firstname is required",
                        pattern: "Only letters allowed",
                        minlength: "Minimum 2 characters"
                    },
                    lastname: {
                        required: "Lastname is required",
                        pattern: "Only letters allowed",
                        minlength: "Minimum 2 characters"
                    },
                    phone: {
                        required: "Phone is required",
                        digits: "Only numbers allowed",
                        minlength: "Minimum 10 digits",
                        maxlength: "Maximum 15 digits"
                    },
                    email: {
                        required: "Email is required",
                        email: "Invalid email format"
                    },
                    companyname: {
                        required: "Company name is required",
                        pattern: "Invalid characters",
                        minlength: "Minimum 2 characters"
                    }
                },
				// Force error messages underneath input
                errorPlacement: function(error, element) {
                    error.addClass('validation-error'); // optional CSS class
                    error.insertAfter(element); // place after input (default is inline)
                },
                submitHandler: function(form) {
                    form.submit(); // only submit if all validation passes
                }
            });

            // Show box & send OTP
            $('#send-otp-btn').on('click', function () {

                let email = $('input[name="email"]').val();

                if (!email) {
                    alert('Please enter your email');
                    return;
                }

                $.ajax({
                    //url: '{{store url="rptechlead/lead/sendOtp"}}',
                    url: '<?php echo $sendOtpUrl; ?>',
                    type: 'POST',
                    data: { email: email },
                    success: function (res) {
                        if (res.success) {
                            $('#otp-box').slideDown();
                            $('#otp-status').text("OTP sent to email");
                            $('#send-otp-btn').hide();
                            $('.otp-digit').val("");
                        } else {
                            alert(res.message);
                        }
                    }
                });
            });

            // Auto move between boxes
            $(document).on('keyup', '.otp-digit', function(e) {
                let $this = $(this);

                if ($this.val().length === 1) {
                    $this.next('.otp-digit').focus();
                }

                if (e.key === 'Backspace' || e.key === 'Delete') {
                    $this.prev('.otp-digit').focus();
                }
            });

            // Verify OTP
            $('#verify-otp-btn').on('click', function () {
                let input_email = $('input[name="email"]').val();
                // Collect digits
                let otp = '';
                $('.otp-digit').each(function() {
                    otp += $(this).val();
                });

                if (otp.length < 6) {
                    $('#otp-status').text("✖ Invalid OTP").css("color", "red");
                    return;
                }else {
                    $('#otp-status').text("")
                }

                $.ajax({
                    //url: '{{store url="rptechlead/lead/verifyOtp"}}',
                    url: '<?php echo $verifyOtpUrl; ?>',
                    type: 'POST',
                    data: { otp: otp, email: input_email },
                    success: function (res) {
                        if (res.success) {
                            $('#otp-status').text("✔ OTP Verified!").css("color", "green");
                            $('#ittbp').prop('disabled', false); //submit button
                            $('#ittbp').show(); //submit button
                            $('#otp-box').hide();
                        } else {
                            $('#otp-status').text("✖ Incorrect OTP").css("color", "red");
                        }
                    }
                });

            });
        });
    });


</script>
