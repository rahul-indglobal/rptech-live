<?xml version="1.0"?>
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
<table name="rptech_webinar_otp" resource="default" engine="innodb" comment="OTP Verification Table">
    <column name="otp_id" xsi:type="int" unsigned="true" nullable="false" identity="true" comment="OTP ID"/>
    <column name="email" xsi:type="varchar" length="255" nullable="false" comment="Email Address"/>
    <column name="otp_code" xsi:type="varchar" length="10" nullable="false" comment="OTP Code"/>
    <column name="verified" xsi:type="smallint" default="0" nullable="false" comment="Is Verified"/>
    <column name="attempt_count" xsi:type="int" default="0" nullable="false" comment="Attempt Count"/>
    <column name="ip_address" xsi:type="varchar" length="64" nullable="true" comment="Requester IP"/>
    <column name="session_id" xsi:type="varchar" length="255" nullable="true" comment="Session ID"/>
    <column name="expires_at" xsi:type="timestamp" nullable="true" comment="Expires At"/>
    <column name="used_at" xsi:type="timestamp" nullable="true" comment="Used At"/>
    <column name="created_at" xsi:type="timestamp" default="CURRENT_TIMESTAMP" nullable="false" comment="Created At"/>

    <constraint xsi:type="primary" referenceId="PRIMARY">
        <column name="otp_id"/>
    </constraint>
</table>
</schema>