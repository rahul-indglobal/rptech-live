<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>

        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Biztech_Inventorysystem::biztech_inventorysystem" title="Biztech Managesupplier"/>
                        </resource>
                    </resource>
                </resource>
                <resource id="Biztech_Inventorysystem::base" title="MageMob Inventory" sortOrder="45">
                    <resource id="Biztech_Inventorysystem::inventorysystem" title="Manage Suppliers" sortOrder="10" />
                    <resource id="Biztech_Inventorysystem::pendingitems" title="Pending Products" sortOrder="20" />
                    <resource id="Biztech_Inventorysystem::pendingorders" title="Pending Orders" sortOrder="30" />
                    <resource id="Biztech_Inventorysystem::purchaseorders" title="Purchase Orders" sortOrder="40" />
                    <resource id="Biztech_Inventorysystem::managestock" title="Manage Stock" sortOrder="40" />
                    <resource id="Biztech_Inventorysystem::stockreceived" title="Stock Received" sortOrder="50" />
                    <resource id="Biztech_Inventorysystem::purchaseinvoice" title="Purchase Invoice" sortOrder="60" />
                </resource>
            </resource>
        </resources>
    </acl>
</config>