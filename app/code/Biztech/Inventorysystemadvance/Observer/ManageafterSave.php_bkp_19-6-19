        $model->setData('qty_processed', $stockData['qty_correction']);
        $model->setData('final_qty', $stockData['qty']);
        $model->setData('interface', $interface);
        $model->setData('user', $user);
        $model->setData('order', '');
        $model->save();
    }

    /**
     * @param   $observer
     * @return  void
     */
    public function getOrderItemStatus($observer)
    {
        $getOrder = $observer->getOrder();
        $isBackordered = 0;
        foreach ($getOrder->getAllItems() as $items) {
            if ($items->getStatus() != "Ordered") {
                $isBackordered = 1;
            }
        }
        if ($isBackordered == 1) {
            $orderModel = $this->_orderModel;
            $orderModel->setBcBackordered(1)->setId($getOrder->getEntityId());
            $orderModel->save();
        }
    }

    /**
     * @param   $observer
     * @return  void
     */
    public function updateWarehoseQty($observer)
    {
        $getOrder = $observer->getOrder();
        $connection = $this->_resource->getConnection();
        foreach ($getOrder->getAllItems() as $items) {
            $getWarehouse = $this->getPriorityWarehouse($items->getProductId(), $connection);
            if ($getWarehouse) {
                // Set default store wise (Warehouse) for the update qty on that storeview (Warehouse)
                
                $defaultWarehouseID = $this->scopeConfig->getValue('inventorysystem/inventorysystemadvance/default_warehouse_select', \Magento\Store\Model\ScopeInterface::SCOPE_STORE, $getOrder->getStoreId());

                // Code coplete here for multiwebsite.

                $qtyOrdered = $items->getQtyOrdered();
                /* Decrease all orderd product quantity from default warehouse */
                for ($i = 0; $i < count($getWarehouse); $i++) {
                    $wareProdModel = $this->_warehouseproductModel->create();
                    if ($getWarehouse[$i]['warehouse_id'] == $defaultWarehouseID) {
                        $defRelID = $getWarehouse[$i]['rel_id'];
                    }
                    if ($defaultWarehouseID == $getWarehouse[$i]['warehouse_id']) {
                        $updQty = (int) $getWarehouse[$i]['quantity'] - $qtyOrdered;
                        $wareProdModel->setId($getWarehouse[$i]['rel_id']);
                        $wareProdModel->setQuantity($updQty);
                        $wareProdModel->save();
                        $qtyOrdered = $qtyOrdered - $getWarehouse[$i]['quantity'];
                    }
                }
            }
            $prodQty = $this->_StockRegistryInterface->getStockItem($items->getProductId())->getQty();
            $min_warehouse_qty = $this->scopeConfig->getValue('inventorysystem/inventorysystemadvance/warehouse_level_quantity', \Magento\Store\Model\ScopeInterface::SCOPE_STORE);
            if ($prodQty < $min_warehouse_qty) {
                $isBackordered = 1;
            }
        }
    }

    /**
     * @param   $productID
