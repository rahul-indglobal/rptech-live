     */
    public function getPriorityWarehouse($productID, $readCon)
    {
        $resource = $this->_resourceConnection;
        $tblName = $resource->getTableName('bc_warehouse_product_is');
        
        $getWarehousesql = $readCon->select()
            ->from($tblName, ['*'])
            ->where('product_id = ' . $productID);
        //->order(array('priority'));
        $getWarehouse = $readCon->fetchAll($getWarehousesql);
        if (!empty($getWarehouse[0])) {
            return $getWarehouse;
        } else {
            return false;
        }
    }

    /**
     * @param   $prodID
     * @param   $wareID
     * @param   $sku
     * @param   $processedQty
     * @param   $interface
     * @param   $user
     * @param   $sysActionArr
     * @param   $actionArr
     * @return  object
     */
    protected function updateDefaultWarehouse($prodID, $wareID, $sku, $processedQty, $interface, $user, $sysActionArr, $actionArr)
    {
        $readCon = $this->_resource->getConnection();
        $tblName = $this->_resource->getTableName('bc_warehouse_product_is');
        
        $getWarehousesql = $readCon->select()
            ->from($tblName, ['rel_id', 'quantity'])
            ->where('product_id = ' . $prodID . ' AND warehouse_id=' . $wareID);
        $getWarehouse = $readCon->fetchAll($getWarehousesql);

        $checkWarehouseAssgnSql = $readCon->select()
            ->from($tblName, ['rel_id', 'quantity'])
            ->where('product_id = ' . $prodID);
        $checkWarehouseAssgn = $readCon->fetchAll($checkWarehouseAssgnSql);

        if (empty($getWarehouse)) {
            $getDefWarehouseQty = 0;
        } else {
            $getDefWarehouseQty = $this->getDefWareQty($getWarehouse[0]['rel_id'], $readCon);
        }
        $wareProdModel = $this->_warehouseproductModel->create();
        $beforeWareQty = 0;
        if (!empty($getWarehouse[0]) && count($getWarehouse) == 1) {
            $beforeWareQty = $getWarehouse[0]['quantity'];
            $assignWareQty = $getWarehouse[0]['quantity'] + $processedQty;
            $wareProdModel->setId($getWarehouse[0]['rel_id']);
            $wareProdModel->setQuantity($assignWareQty);
            $wareProdModel->save();
        } else {
            $defaultWarehouseID = $this->_bizInvHelper->getConfig('inventorysystem/inventorysystemadvance/default_warehouse_select');
            if ($wareID == $defaultWarehouseID && empty($checkWarehouseAssgn)) {
                //$stock = $this->_catalogStock->get($prodID);
                $stock = $this->_StockRegistryInterface->getStockItem($prodID);
                $wareProdModel->setWarehouseId($defaultWarehouseID);
                $wareProdModel->setProductId($prodID);
                $wareProdModel->setQuantity($stock->getQty());
                $wareProdModel->setPosition(0);
                //$wareProdModel->setPriority(1);
                $wareProdModel->save();
            } else {
                $beforeWareQty = 0;
                $assignWareQty = $processedQty;
                $wareProdModel->setWarehouseId($wareID);
                $wareProdModel->setProductId($prodID);
                $wareProdModel->setQuantity($assignWareQty);
                $wareProdModel->setPosition(0);
                // $wareProdModel->setPriority(1);
                $wareProdModel->save();
            }
        }
        $this->warehouseInventoryLog($wareID, $beforeWareQty, $assignWareQty, '', $sku, $interface, $user, $sysActionArr, $actionArr);
    }

    /**
     * @param   $defRelID
     * @param   $readCon
     * @return int
     */
    protected function getDefWareQty($defRelID, $readCon)
    {
        $tblName = $this->_resource->getTableName('bc_warehouse_product_is');
        $getDefWareQtysql = $readCon->select()
            ->from($tblName, ['quantity'])
            ->where('rel_id = ' . $defRelID);
        $getDefWareQty = $readCon->fetchAll($getDefWareQtysql);
        return (int) $getDefWareQty[0]['quantity'];
    }
